JWT_SECRET=
# Optional: defaults to 23 leading zero bits (about 15 seconds on a typical desktop).
# Increase or decrease this after observing real client solve times.
REGISTRATION_POW_DIFFICULTY=23
# A challenge expires after five minutes and can be used once.
REGISTRATION_POW_TTL_MS=300000
# Optional separate signing key; defaults to JWT_SECRET when omitted.
REGISTRATION_POW_SECRET=
MONGODB_URI=mongodb://127.0.0.1:27017/taskstack
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DATABASE=
